# Copy to .env and fill in. Never commit .env.

# --- Required for YouTube discovery ---------------------------------------
# Free. Create at https://console.cloud.google.com/apis/credentials then enable
# "YouTube Data API v3". Default quota is 10,000 units/day; a search costs 100
# units and a 50-channel hydrate costs 1, so budget roughly 90 searches/day.
YOUTUBE_API_KEY=

# --- Optional: better podcast coverage ------------------------------------
# Free key from https://api.podcastindex.org/signup — improves coverage of small
# and Indian shows, and returns ownerEmail directly. Without it the free iTunes
# Search API is used instead.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# --- Optional: Instagram / TikTok via licensed vendors ---------------------
# There is no compliant public search API for Instagram or TikTok. These vendors
# hold the platform agreements. See src/creatorcontacts/sources/providers.py.
MODASH_API_KEY=
INSIGHTIQ_CLIENT_ID=
INSIGHTIQ_SECRET=

# --- Good practice --------------------------------------------------------
# A URL site owners can visit to find out who is crawling them and how to opt
# out. Goes into the User-Agent on every request. Set this.
OUTREACH_CONTACT_URL=https://github.com/TalibKhan-Newbie/claudecode
